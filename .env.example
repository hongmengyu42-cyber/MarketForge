# ═══════════════════════════════════════════════════════════════════
# MarketForge — Production Environment Configuration (.env)
# Copy this file to .env and replace all placeholder values.
# ═══════════════════════════════════════════════════════════════════

# ──── Application & Ports ────
HTTP_PORT=80
HOST_DB_PORT=3306
FRONTEND_URL=https://marketforge.dev
ALLOWED_ORIGINS=https://marketforge.dev,https://www.marketforge.dev

# ──── Database (MySQL 8.0) ────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=marketforge
DB_USERNAME=marketforge_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# ──── Authentication Security (JWT HS256) ────
# Generate using: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_48_CHAR_SECRET_KEY_FOR_JWT

# ──── Stripe Payment & Escrow Gateway ────
STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_signing_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_stripe_publishable_key

# ──── Google OAuth2 SSO ────
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com

# ──── Transactional Email Delivery (SendGrid, Mailgun, AWS SES, or SMTP) ────
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=replace_with_sendgrid_api_key

# ──── File Storage ────
BASE_URL=https://api.marketforge.dev
UPLOAD_DIR=/app/uploads
