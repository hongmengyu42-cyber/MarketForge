# Environment and secrets
.env
.env.*
!.env.example

# Node.js
node_modules/
frontend/node_modules/
backend/node_modules/

# PHP / Laravel dependencies
vendor/
backend/vendor/

# Build files
dist/
build/
frontend/dist/
*.tsbuildinfo

# Java / Maven
target/
backend/target/

# IDE
.idea/
.vscode/

# macOS
.DS_Store

# User uploads (avoid publishing private user data)
uploads/*
!uploads/.gitkeep

# Logs
*.log# 
══════════════════════════════════════════════════════════
# MarketForge — Root .gitignore
# ══════════════════════════════════════════════════════════

# ──── Operating System ────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ──── Secrets & Environment ────
.env
.env.local
.env.*.local
*.pem
*.key

# ──── Node.js / Frontend ────
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──── Java / Spring Boot Backend ────
backend/target/
backend/bin/
backend/.classpath
backend/.project
backend/.settings/
backend/*.iml
backend/.idea/
.mvn/timing.properties

# ──── Runtime Uploads & Backups ────
uploads/*
!uploads/.gitkeep
backups/

# ──── IDEs & Editors ────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
